---
/**
 * Genel iletişim formu. URL parametreleriyle ön doldurulabilir:
 *   ?topic=<anahtar>   → konu seçimi (contracting | renewal | partnership | other)
 *   ?project=<slug>    → "İlgili proje" alanı (proje detayındaki çağrılar bunu kullanır)
 * Bilinmeyen değerler yok sayılır. Bkz. contactPath() — src/i18n/routes.ts
 */
import type { Lang } from '@/i18n/config';
import { ui } from '@/i18n/ui';
import { useTranslations } from '@/i18n/utils';
import { getProjects } from '@/lib/projects';
import Web3Form from './Web3Form.astro';
import TextField from './TextField.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
// Seçeneklerin değeri her dilde Türkçe gider; e-postayı okuyan ekip için.
const topicValues = ui.tr.forms.topics;
const topics = Object.keys(t.forms.topics) as (keyof typeof t.forms.topics)[];

// slug → { görünen ad (sayfa dili), gönderilen değer (Türkçe başlık + slug) }
const trTitles = new Map((await getProjects('tr')).map((p) => [p.slug, p.data.title]));
const projectMap = Object.fromEntries(
  (await getProjects(lang)).map((p) => [
    p.slug,
    { label: p.data.title, value: `${trTitles.get(p.slug) ?? p.data.title} (${p.slug})` },
  ]),
);
---

<Web3Form lang={lang} subject="Web sitesi — iletişim formu" id="iletisim-formu">
  <div class="grid gap-5 sm:grid-cols-2">
    <TextField lang={lang} name="name" label={t.forms.name} required autocomplete="name" />
    <TextField lang={lang} name="Kurum" label={t.forms.company} autocomplete="organization" />
    <TextField lang={lang} name="email" type="email" label={t.forms.email} required autocomplete="email" />
    <TextField lang={lang} name="Telefon" type="tel" label={t.forms.phone} autocomplete="tel" inputmode="tel" />

    <div class="sm:col-span-2">
      <label for="contact-topic" class="field-label">
        {t.forms.topic} <span class="text-signal-700" aria-hidden="true">*</span>
      </label>
      <select id="contact-topic" name="Konu" required class="field-input" data-topic-select>
        <option value="">{t.forms.select}</option>
        {topics.map((key) => <option value={topicValues[key]} data-key={key}>{t.forms.topics[key]}</option>)}
      </select>
    </div>

    <div class="border-ink bg-concrete-100 flex items-start justify-between gap-4 border-l-4 px-4 py-3 sm:col-span-2" data-project-field hidden>
      <p class="min-w-0">
        <span class="eyebrow text-concrete-600 block">{t.forms.relatedProject}</span>
        <span class="mt-1 block font-semibold" data-project-label></span>
      </p>
      <button type="button" class="link shrink-0 text-sm" data-project-remove>{t.forms.removeProject}</button>
      <input type="hidden" name="İlgili proje" disabled data-project-input />
    </div>

    <TextField lang={lang} name="Mesaj" label={t.forms.message} required multiline class="sm:col-span-2" />
  </div>

  <label class="text-concrete-700 mt-6 flex items-start gap-3 text-sm">
    <input type="checkbox" name="KVKK onayı" value="Evet" required class="accent-signal-600 mt-0.5 size-5 shrink-0" />
    <span>{t.forms.consent}</span>
  </label>

  <button type="submit" class="btn-primary mt-8 w-full sm:w-auto">
    {t.forms.send}
    <span aria-hidden="true">→</span>
  </button>
</Web3Form>

<script type="application/json" id="contact-project-map" set:html={JSON.stringify(projectMap)} />

<script>
  type ProjectMap = Record<string, { label: string; value: string }>;
  const params = new URLSearchParams(location.search);

  // Konu
  const select = document.querySelector<HTMLSelectElement>('[data-topic-select]');
  const topic = params.get('topic');
  const option = topic ? select?.querySelector<HTMLOptionElement>(`option[data-key="${CSS.escape(topic)}"]`) : null;
  if (select && option) select.value = option.value;

  // İlgili proje
  const field = document.querySelector<HTMLElement>('[data-project-field]');
  const input = field?.querySelector<HTMLInputElement>('[data-project-input]');
  const projects = JSON.parse(document.getElementById('contact-project-map')?.textContent ?? '{}') as ProjectMap;
  const project = projects[params.get('project') ?? ''];

  if (field && input && project) {
    field.querySelector('[data-project-label]')!.textContent = project.label;
    input.value = project.value;
    input.disabled = false;
    field.hidden = false;

    field.querySelector('[data-project-remove]')?.addEventListener('click', () => {
      input.disabled = true;
      field.hidden = true;
      select?.focus();
    });
  }
</script>
