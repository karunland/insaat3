---
/**
 * Proje fotoğraf galerisi + lightbox.
 *
 * Her küçük görsel, büyük boyutlu görsele giden gerçek bir bağlantıdır; JS yoksa
 * görsel tarayıcıda açılır. JS varsa src/scripts/lightbox.ts yerel <dialog> içinde
 * gösterir (klavye: ← → Esc, dokunmatik: kaydırma).
 */
import type { ImageMetadata } from 'astro';
import { getImage, Image } from 'astro:assets';
import type { Lang } from '@/i18n/config';
import { useTranslations } from '@/i18n/utils';

interface Props {
  lang: Lang;
  images: { src: ImageMetadata; alt: string }[];
  id?: string;
}

const { lang, images, id = 'galeri' } = Astro.props;
const t = useTranslations(lang);

// İlk görseli büyüt, ama son satır yarım kalmasın (md ve üstü 3 sütun):
//  - 4, 7, 10… görsel → ilk görsel tam genişlik bant
//  - 3, 6, 9… görsel  → ilk görsel 2×2
//  - diğerleri        → eşit ızgara
const featureLayout =
  images.length > 1 && (images.length - 1) % 3 === 0 ? 'banner' : images.length % 3 === 0 ? 'block' : 'none';
const featureClass = { banner: 'col-span-2 md:col-span-3', block: 'col-span-2 row-span-2', none: '' }[featureLayout];
const FEATURE_SIZES = {
  banner: '(min-width: 1408px) 1328px, 100vw',
  block: '(min-width: 768px) 66vw, 100vw',
  none: '',
};

const items = await Promise.all(
  images.map(async (image) => {
    const full = await getImage({ src: image.src, widths: [1024, 1600, 2400], format: 'webp' });
    return { ...image, full };
  }),
);
---

{
  items.length > 0 && (
    <div data-gallery>
      <ul class="grid grid-cols-2 gap-2 sm:gap-3 md:grid-cols-3" id={id}>
        {items.map((item, i) => (
          <li class:list={[i === 0 && featureClass]}>
            <a
              href={item.full.src}
              class="group bg-concrete-200 relative block size-full overflow-hidden"
              data-lightbox-item
              data-srcset={item.full.srcSet.attribute}
              data-alt={item.alt}
            >
              <Image
                src={item.src}
                alt={item.alt}
                widths={i === 0 && featureClass ? [640, 960, 1280, 1600, 2000] : [320, 480, 640, 800]}
                sizes={i === 0 && featureClass ? FEATURE_SIZES[featureLayout] : '(min-width: 768px) 33vw, 50vw'}
                class:list={[
                  'size-full object-cover transition duration-500 group-hover:opacity-90 motion-safe:group-hover:scale-[1.02]',
                  i === 0 && featureLayout === 'banner' ? 'aspect-[21/9]' : 'aspect-[4/3]',
                ]}
              />
              <span class="eyebrow bg-paper/90 text-ink absolute bottom-0 left-0 px-2 py-1" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
            </a>
          </li>
        ))}
      </ul>
      <p class="text-concrete-600 mt-4 text-sm">{t.project.galleryHint}</p>

      <dialog
        class="lightbox bg-concrete-950/95 text-paper m-0 size-full max-h-none max-w-none p-0 backdrop:bg-transparent"
        aria-label={t.lightbox.label}
        data-lightbox
      >
        <div class="flex h-full flex-col">
          <div class="flex items-center justify-between gap-4 px-4 py-3 sm:px-6">
            <p class="eyebrow text-concrete-300" aria-live="polite" data-lightbox-counter data-template={t.lightbox.counter} />
            <button
              type="button"
              class="hover:bg-paper/10 inline-flex size-12 items-center justify-center"
              data-lightbox-close
              aria-label={t.lightbox.close}
            >
              <svg viewBox="0 0 24 24" class="size-6" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                <path d="M5 5l14 14M19 5L5 19" />
              </svg>
            </button>
          </div>

          <figure class="relative flex min-h-0 flex-1 flex-col items-center justify-center px-2 sm:px-20">
            <img class="max-h-full max-w-full object-contain select-none" alt="" sizes="100vw" data-lightbox-image draggable="false" />
            <figcaption class="text-concrete-300 px-4 py-4 text-center text-sm" data-lightbox-caption />
          </figure>

          <div class="pointer-events-none absolute inset-x-0 top-1/2 flex -translate-y-1/2 justify-between px-2 sm:px-4">
            <button
              type="button"
              class="bg-concrete-900/70 hover:bg-signal-600 pointer-events-auto inline-flex size-12 items-center justify-center transition-colors"
              data-lightbox-prev
              aria-label={t.lightbox.prev}
            >
              <svg viewBox="0 0 24 24" class="size-6" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                <path d="M15 5l-7 7 7 7" />
              </svg>
            </button>
            <button
              type="button"
              class="bg-concrete-900/70 hover:bg-signal-600 pointer-events-auto inline-flex size-12 items-center justify-center transition-colors"
              data-lightbox-next
              aria-label={t.lightbox.next}
            >
              <svg viewBox="0 0 24 24" class="size-6" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                <path d="M9 5l7 7-7 7" />
              </svg>
            </button>
          </div>
        </div>
      </dialog>
    </div>
  )
}

<script>
  import { initLightbox } from '@/scripts/lightbox';
  initLightbox();
</script>

<style>
  /* Açılış animasyonu yalnızca hareket tercihi izin veriyorsa. */
  @media (prefers-reduced-motion: no-preference) {
    .lightbox[open] {
      animation: lightbox-in 200ms var(--ease-draft);
    }
    @keyframes lightbox-in {
      from {
        opacity: 0;
      }
    }
  }
</style>
