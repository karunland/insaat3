---
import type { Status } from '@/content.config';
import type { Lang } from '@/i18n/config';
import { useTranslations } from '@/i18n/utils';

interface Props {
  lang: Lang;
  status: Status;
  class?: string;
}

const { lang, status, class: className } = Astro.props;
const t = useTranslations(lang);
---

<span class:list={['eyebrow inline-flex items-center gap-2', className]}>
  <span
    class:list={[
      'size-2 shrink-0',
      status === 'ongoing' ? 'bg-signal-600 motion-safe:animate-pulse' : 'bg-concrete-500',
    ]}
    aria-hidden="true"></span>
  {t.statusLabel[status]}
</span>
