---
/**
 * <head> içindeki SEO etiketleri: başlık, açıklama, canonical, hreflang,
 * Open Graph / Twitter ve Organization yapılandırılmış verisi.
 */
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import { defaultLang, languages, langs, type Lang } from '@/i18n/config';
import type { Alternates } from '@/i18n/routes';
import { routes } from '@/i18n/routes';
import { useTranslations } from '@/i18n/utils';
import { site } from '@/config/site';

export interface SeoProps {
  title?: string;
  description?: string;
  /** Sosyal paylaşım görseli. Verilmezse public/og-default.jpg kullanılır. */
  image?: ImageMetadata;
  imageAlt?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
}

interface Props extends SeoProps {
  lang: Lang;
  alternates: Alternates;
}

const { lang, alternates, title, description, image, imageAlt, type = 'website', noindex = false } =
  Astro.props;
const t = useTranslations(lang);

const siteUrl = Astro.site ?? new URL(Astro.url.origin);
const abs = (path: string) => new URL(path, siteUrl).href;

const fullTitle = title ? `${title} | ${t.meta.siteName}` : t.meta.defaultTitle;
const metaDescription = description ?? t.meta.defaultDescription;
const canonical = abs(alternates[lang]);

let ogImage = abs('/og-default.jpg');
if (image) {
  const optimized = await getImage({ src: image, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
  ogImage = abs(optimized.src);
}

const { address } = site;
const sameAs = Object.values(site.social).filter(Boolean);
const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  legalName: site.legalName,
  url: abs(routes.home[defaultLang]),
  logo: abs('/favicon.svg'),
  telephone: site.phone,
  email: site.email,
  description: t.meta.defaultDescription,
  areaServed: { '@type': 'City', name: 'İstanbul' },
  address: {
    '@type': 'PostalAddress',
    ...(address.street ? { streetAddress: address.street } : {}),
    ...(address.district ? { addressRegion: address.district } : {}),
    addressLocality: address.city,
    addressCountry: address.country,
  },
  ...(sameAs.length > 0 ? { sameAs } : {}),
};
---

<title>{fullTitle}</title>
<meta name="description" content={metaDescription} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, follow" />}

{langs.map((l) => <link rel="alternate" hreflang={languages[l].htmlLang} href={abs(alternates[l])} />)}
<link rel="alternate" hreflang="x-default" href={abs(alternates[defaultLang])} />

<meta property="og:type" content={type} />
<meta property="og:site_name" content={t.meta.siteName} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={metaDescription} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
{imageAlt && <meta property="og:image:alt" content={imageAlt} />}
<meta property="og:locale" content={languages[lang].ogLocale} />
{
  langs
    .filter((l) => l !== lang)
    .map((l) => <meta property="og:locale:alternate" content={languages[l].ogLocale} />)
}
<meta name="twitter:card" content="summary_large_image" />

<script is:inline type="application/ld+json" set:html={JSON.stringify(organization)} />
